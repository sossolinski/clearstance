---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import {
  getTranslations,
  getVisibleTranslations
} from '../../i18n/translations';
import Logo from '../ui/Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const visible = getVisibleTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-primary">
    <a class="brand-link" href={getRoute(locale, 'home')} aria-label={t.site.homeLabel}>
      <Logo dark />
    </a>
    <p>{visible.site.footerTagline}</p>
    <nav aria-label={locale === 'pl' ? 'Nawigacja w stopce' : 'Footer navigation'}>
      <a href={getRoute(locale, 'services')}>{visible.site.nav.services}</a>
      <a href={getRoute(locale, 'insights')}>{visible.site.nav.insights}</a>
      <a href={getRoute(locale, 'about')}>{visible.site.nav.experience}</a>
      <a href={getRoute(locale, 'contact')}>{visible.site.nav.contact}</a>
    </nav>
  </div>
  <div class="wrap footer-secondary">
    <span>© {year} {visible.site.copyright}</span>
    <span>{visible.site.location}</span>
  </div>
</footer>
