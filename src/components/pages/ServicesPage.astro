---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import {
  getTranslations,
  getVisibleTranslations
} from '../../i18n/translations';
import { getServiceIconName } from '../../lib/service-icons';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBand from '../sections/ContactBand.astro';
import PageIntro from '../sections/PageIntro.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const content = getVisibleTranslations(locale).servicesPage;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
---

<BaseLayout
  locale={locale}
  title={t.servicesPage.metaTitle}
  description={t.servicesPage.metaDescription}
  canonicalPath={getRoute(locale, 'services')}
  alternatePath={getRoute(otherLocale, 'services')}
  plPath={getRoute('pl', 'services')}
  enPath={getRoute('en', 'services')}
  xDefaultPath={getRoute('pl', 'services')}
  currentPage="services"
>
  <main id="main-content">
    <PageIntro
      eyebrow={content.eyebrow}
      title={content.title}
      lead={content.lead}
      desktopTitleLines={locale === 'pl'
        ? ['Gotowość,', 'która działa', 'w\u00a0rzeczywistym', 'środowisku.']
        : undefined}
    />

    <section class="services-detail" aria-labelledby="services-detail-title">
      <div class="wrap">
        <div class="editorial-heading" data-reveal>
          <h2 id="services-detail-title">{content.introTitle}</h2>
          <p>{content.intro}</p>
        </div>
        <ol class="services-detail-list">
          {
            content.services.map((service, index) => (
              <li data-reveal>
                <div class="detail-marker">
                  <Icon
                    class="detail-icon"
                    name={getServiceIconName(index)}
                    size={40}
                    decorative
                  />
                </div>
                <div class="detail-copy">
                  <h3 class:list={{ 'service-title--long': index === 3 }}>
                    {service.title}
                  </h3>
                  <p>{service.summary}</p>
                  {
                    'note' in service && service.note && (
                      <p class="service-scope-note">{service.note}</p>
                    )
                  }
                </div>
                <ul>
                  {service.points.map((point) => <li>{point}</li>)}
                </ul>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="context-section" aria-labelledby="context-title">
      <div class="wrap context-grid" data-reveal>
        <div class="context-heading">
          <h2 id="context-title">{content.closingTitle}</h2>
        </div>
        <div class="context-body">
          <p class="context-copy">{content.closingText}</p>
          <ul class="context-references">
            {
              content.closingReferences.map((reference) => (
                <li>
                  <strong class="context-reference-code">{reference.code}</strong>
                  <span class="context-reference-separator" aria-hidden="true"> — </span>
                  <span class="context-reference-description">
                    {reference.description}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <ContactBand locale={locale} />
  </main>
</BaseLayout>
