---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import { getCommercialContent } from '../../content/commercial';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getInsightsByTranslationKeys } from '../../lib/insights';
import CommercialInsights from '../insights/CommercialInsights.astro';
import ContactBand from '../sections/ContactBand.astro';
import PageIntro from '../sections/PageIntro.astro';
import Icon from '../ui/Icon.astro';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const content = getCommercialContent(locale);
const page = content.advisory;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const capabilityIcons = ['network', 'message-text', 'community'] as const;
const insights = await getInsightsByTranslationKeys(locale, ['crisis-situational-awareness', 'continuity-at-interfaces', 'first-hour-crisis-communication']);
const schema = {
  '@context': 'https://schema.org', '@type': 'Service', name: page.hero.title,
  serviceType: locale === 'pl' ? 'Doradztwo w zakresie gotowości kryzysowej' : 'Crisis readiness advisory',
  provider: { '@type': 'Organization', name: 'ClearStance' },
  url: new URL(getRoute(locale, 'services'), Astro.site).toString(),
  areaServed: { '@type': 'Country', name: 'Poland' }
};
---

<BaseLayout locale={locale} title={page.meta.title} description={page.meta.description}
  canonicalPath={getRoute(locale, 'services')} alternatePath={getRoute(otherLocale, 'services')}
  plPath={getRoute('pl', 'services')} enPath={getRoute('en', 'services')} xDefaultPath={getRoute('pl', 'services')}
  currentPage="services" structuredData={schema}>
  <main id="main-content" class="commercial-page">
    <PageIntro eyebrow={page.hero.eyebrow} title={page.hero.title} lead={page.hero.lead} />

    <section class="commercial-intro" aria-labelledby="advisory-intro-title"><div class="wrap commercial-intro-grid" data-reveal>
      <div><p class="eyebrow">{locale === 'pl' ? 'Punkt wyjścia' : 'Starting point'}</p><h2 id="advisory-intro-title">{page.intro.title}</h2><p class="section-lead">{page.intro.text}</p></div>
      <ul class="trigger-grid">{page.intro.triggers.map((item) => <li><h3>{item.title}</h3><p>{item.text}</p></li>)}</ul>
    </div></section>

    <section class="commercial-capability-detail" aria-labelledby="advisory-capabilities-title"><div class="wrap">
      <div class="commercial-section-heading" data-reveal><p class="eyebrow">{page.capabilities.eyebrow}</p><h2 id="advisory-capabilities-title">{page.capabilities.title}</h2><p>{page.capabilities.intro}</p></div>
      <ol class="capability-detail-list">{content.capabilities.map((capability, index) => <li id={capability.anchor} data-reveal>
        <div class="capability-detail-heading"><Icon name={capabilityIcons[index]} size={38} decorative /><p>{String(index + 1).padStart(2, '0')}</p><h3>{capability.title}</h3><p>{capability.text}</p>{capability.id === 'crisis-management' && <a class="text-link capability-detail-link" href={getRoute(locale, 'crisisManagement')}>{locale === 'pl' ? 'Poznaj obszar' : 'Explore the capability'} <span aria-hidden="true">→</span></a>}</div>
        <div><h4>{locale === 'pl' ? 'Przykładowy zakres' : 'Example scope'}</h4><ul class="check-list">{capability.scope.map((item) => <li>{item}</li>)}</ul></div>
        <div><h4>{locale === 'pl' ? 'Możliwe rezultaty' : 'Possible outcomes'}</h4><ul class="check-list">{capability.outputs.map((item) => <li>{item}</li>)}</ul></div>
      </li>)}</ol>
    </div></section>

    <section class="product-module" id={locale === 'pl' ? 'przeglad-gotowosci' : 'readiness-review'} aria-labelledby="review-title"><div class="wrap" data-reveal>
      <div class="product-module-hero"><div><p class="eyebrow eyebrow--light">{page.review.eyebrow}</p><h2 id="review-title">{page.review.title}</h2><p class="product-descriptor">{page.review.descriptor}</p></div><p>{page.review.lead}</p></div>
      <div class="product-module-grid">
        <article><h3>{page.review.triggerTitle}</h3><ul class="check-list check-list--light">{page.review.triggers.map((item) => <li>{item}</li>)}</ul></article>
        <article><h3>{page.review.audienceTitle}</h3><p>{page.review.audience}</p><h3>{page.review.scopeTitle}</h3><ul class="check-list check-list--light">{page.review.scope.map((item) => <li>{item}</li>)}</ul></article>
      </div>
      <div class="deliverable-split"><article><h3>{page.review.includesTitle}</h3><ul>{page.review.includes.map((item) => <li>{item}</li>)}</ul></article><article><h3>{page.review.receivesTitle}</h3><ul>{page.review.receives.map((item) => <li>{item}</li>)}</ul></article></div>
      <div class="product-outcome"><div><h3>{page.review.outcomeTitle}</h3><p>{page.review.outcome}</p></div><div><h3>{page.review.nextTitle}</h3><p>{page.review.next}</p></div><a class="button button--ghost" href={`${getRoute(locale, 'contact')}?topic=crisis-readiness-review`}><span>{page.review.cta}</span><span aria-hidden="true">↗</span></a></div>
    </div></section>

    <section class="focused-scope" id={locale === 'pl' ? 'model-dzialania-cmt' : 'cmt-operating-model'} aria-labelledby="cmt-title"><div class="wrap focused-scope-grid" data-reveal><div><p class="eyebrow">{page.cmt.eyebrow}</p><h2 id="cmt-title">{page.cmt.title}</h2><p>{page.cmt.text}</p></div><ul class="check-list">{page.cmt.points.map((item) => <li>{item}</li>)}</ul></div></section>

    <section class="commercial-process" aria-labelledby="advisory-process-title"><div class="wrap">
      <div class="commercial-section-heading" data-reveal><p class="eyebrow">{page.process.eyebrow}</p><h2 id="advisory-process-title">{page.process.title}</h2><p>{page.process.intro}</p></div>
      <ol class="numbered-process" data-reveal>{page.process.items.map((item, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}</ol>
      <div class="outputs-panel" data-reveal><h3>{page.outputs.title}</h3><p>{page.outputs.intro}</p><ul class="check-list">{page.outputs.items.map((item) => <li>{item}</li>)}</ul></div>
    </div></section>

    {insights.length > 0 && <CommercialInsights locale={locale} entries={insights} eyebrow={page.insights.eyebrow} title={page.insights.title} copy={page.insights.copy} />}
    <ContactBand locale={locale} content={page.contact} topic="advisory" />
  </main>
</BaseLayout>
