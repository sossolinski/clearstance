---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import {
  getTranslations,
  getVisibleTranslations
} from '../../i18n/translations';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactBand from '../sections/ContactBand.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const visible = getVisibleTranslations(locale);
const content = visible.aboutPage;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
---

<BaseLayout
  locale={locale}
  title={t.aboutPage.metaTitle}
  description={t.aboutPage.metaDescription}
  canonicalPath={getRoute(locale, 'about')}
  alternatePath={getRoute(otherLocale, 'about')}
  plPath={getRoute('pl', 'about')}
  enPath={getRoute('en', 'about')}
  xDefaultPath={getRoute('pl', 'about')}
  currentPage="about"
>
  <main id="main-content">
    <PageIntro
      eyebrow={content.eyebrow}
      title={content.title}
      lead={content.lead}
      variant="about"
    />

    <section class="about-story" aria-labelledby="about-story-title">
      <div class="wrap about-story-grid">
        <figure data-reveal>
          <picture>
            <source
              srcset="
                /images/operational-briefing-640.webp 640w,
                /images/operational-briefing-960.webp 960w,
                /images/operational-briefing-1440.webp 1440w,
                /images/operational-briefing.webp 1920w
              "
              sizes="
                (max-width: 760px) calc(100vw - 32px),
                (max-width: 1080px) 47vw,
                540px
              "
              type="image/webp"
            />
            <img
              src="/images/operational-briefing.jpg"
              width="1920"
              height="1080"
              alt={t.home.experience.imageAlt}
              loading="eager"
            />
          </picture>
          <figcaption>{visible.home.experience.eyebrow}</figcaption>
        </figure>
        <div class="about-story-copy" data-reveal>
          <h2 id="about-story-title">{content.storyTitle}</h2>
          {content.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="about-perspective" aria-labelledby="about-perspective-title">
      <div class="wrap about-perspective-grid" data-reveal>
        <div class="about-compass" aria-hidden="true">
          <svg viewBox="0 0 260 260">
            <circle cx="130" cy="130" r="104"></circle>
            <circle cx="130" cy="130" r="63"></circle>
            <path d="M130 14v28M130 218v28M14 130h28M218 130h28"></path>
            <circle class="signal-dot" cx="218" cy="130" r="5"></circle>
          </svg>
        </div>
        <div>
          <p class="eyebrow eyebrow--teal">Navigation under uncertainty</p>
          <h2 id="about-perspective-title">{content.perspectiveTitle}</h2>
          <p>{content.perspectiveText}</p>
        </div>
      </div>
    </section>

    <ContactBand locale={locale} />
  </main>
</BaseLayout>
