---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import { getCommercialContent } from '../../content/commercial';
import { getContactPathWithTopic } from '../../lib/contact-topics';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getInsightsByTranslationKeys } from '../../lib/insights';
import CommercialInsights from '../insights/CommercialInsights.astro';
import ContactBand from '../sections/ContactBand.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const page = getCommercialContent(locale).crisisCommunication;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const insights = await getInsightsByTranslationKeys(locale, [
  'first-hour-crisis-communication',
  'crisis-situational-awareness'
]);
const absolute = (path: string) => new URL(path, Astro.site).toString();
const routeHref = (id: typeof page.routes.items[number]['id']) => {
  if (id === 'advisory') {
    return `${getRoute(locale, 'services')}#${locale === 'pl' ? 'komunikacja-kryzysowa' : 'crisis-communication'}`;
  }

  if (id === 'communication-simulation') {
    return `${getRoute(locale, 'exercises')}#communication-simulation`;
  }

  return getRoute(locale, 'executiveTabletop');
};
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.hero.eyebrow,
    description: page.meta.description,
    serviceType: locale === 'pl' ? 'Przygotowanie do komunikacji kryzysowej' : 'Crisis communication preparedness',
    provider: { '@type': 'Organization', name: 'ClearStance' },
    url: absolute(getRoute(locale, 'crisisCommunication')),
    areaServed: { '@type': 'Country', name: 'Poland' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: locale === 'pl' ? 'Strona główna' : 'Home', item: absolute(getRoute(locale, 'home')) },
      { '@type': 'ListItem', position: 2, name: locale === 'pl' ? 'Doradztwo' : 'Advisory', item: absolute(getRoute(locale, 'services')) },
      { '@type': 'ListItem', position: 3, name: page.hero.eyebrow, item: absolute(getRoute(locale, 'crisisCommunication')) }
    ]
  }
];
---

<BaseLayout
  locale={locale}
  title={page.meta.title}
  description={page.meta.description}
  canonicalPath={getRoute(locale, 'crisisCommunication')}
  alternatePath={getRoute(otherLocale, 'crisisCommunication')}
  plPath={getRoute('pl', 'crisisCommunication')}
  enPath={getRoute('en', 'crisisCommunication')}
  xDefaultPath={getRoute('pl', 'crisisCommunication')}
  currentPage="services"
  structuredData={schema}
>
  <main id="main-content" class="commercial-page capability-page crisis-communication-page">
    <PageIntro
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      lead={page.hero.lead}
      action={{
        label: page.hero.cta,
        href: getContactPathWithTopic(locale, 'crisis-communication')
      }}
    />

    <section class="capability-situations" aria-labelledby="communication-situations-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow">{page.situations.eyebrow}</p>
          <h2 id="communication-situations-title">{page.situations.title}</h2>
          <p>{page.situations.intro}</p>
        </div>
        <ol class="capability-situation-list" data-reveal>
          {page.situations.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="capability-first-hours" aria-labelledby="first-hours-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow">{page.firstHours.eyebrow}</p>
          <h2 id="first-hours-title">{page.firstHours.title}</h2>
        </div>
        <ol class="first-hour-sequence" data-reveal>
          {page.firstHours.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="capability-routes" aria-labelledby="communication-routes-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow eyebrow--light">{page.routes.eyebrow}</p>
          <h2 id="communication-routes-title">{page.routes.title}</h2>
        </div>
        <ol class="capability-route-list" data-reveal>
          {page.routes.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a class="text-link text-link--light" href={routeHref(item.id)}>
                {item.link} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="capability-outcomes" aria-labelledby="communication-outcomes-title">
      <div class="wrap capability-editorial-grid">
        <div data-reveal>
          <p class="eyebrow">{page.outcomes.eyebrow}</p>
          <h2 id="communication-outcomes-title">{page.outcomes.title}</h2>
        </div>
        <ul class="capability-outcome-list" data-reveal>
          {page.outcomes.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    {insights.length > 0 && (
      <CommercialInsights
        locale={locale}
        entries={insights}
        eyebrow={page.insights.eyebrow}
        title={page.insights.title}
        copy={page.insights.copy}
      />
    )}
    <ContactBand locale={locale} content={page.contact} topic="crisis-communication" />
  </main>
</BaseLayout>
