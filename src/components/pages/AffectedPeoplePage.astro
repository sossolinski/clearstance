---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import { getCommercialContent } from '../../content/commercial';
import { getContactPathWithTopic } from '../../lib/contact-topics';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getInsightsByTranslationKeys } from '../../lib/insights';
import CommercialInsights from '../insights/CommercialInsights.astro';
import ContactBand from '../sections/ContactBand.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const page = getCommercialContent(locale).affectedPeople;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const insights = await getInsightsByTranslationKeys(locale, [
  'continuity-at-interfaces',
  'first-hour-crisis-communication'
]);
const absolute = (path: string) => new URL(path, Astro.site).toString();
const responsibilityHref = (id: typeof page.responsibilities.items[number]['id']) => {
  if (id === 'cmt') return getRoute(locale, 'crisisManagement');
  if (id === 'communication') return getRoute(locale, 'crisisCommunication');
  return undefined;
};
const responsibilityLink = (id: typeof page.responsibilities.items[number]['id']) =>
  id === 'cmt'
    ? page.responsibilities.crisisManagementLink
    : page.responsibilities.crisisCommunicationLink;
const routeHref = (id: typeof page.routes.items[number]['id']) =>
  id === 'advisory'
    ? `${getRoute(locale, 'services')}#${locale === 'pl' ? 'wsparcie-osob-i-rodzin' : 'affected-people'}`
    : `${getRoute(locale, 'exercises')}#affected-people-exercise`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.hero.eyebrow,
    description: page.meta.description,
    serviceType: locale === 'pl' ? 'Wsparcie osób dotkniętych zdarzeniem' : 'Affected people and family assistance',
    provider: { '@type': 'Organization', name: 'ClearStance' },
    url: absolute(getRoute(locale, 'affectedPeople')),
    areaServed: { '@type': 'Country', name: 'Poland' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: locale === 'pl' ? 'Strona główna' : 'Home', item: absolute(getRoute(locale, 'home')) },
      { '@type': 'ListItem', position: 2, name: locale === 'pl' ? 'Doradztwo' : 'Advisory', item: absolute(getRoute(locale, 'services')) },
      { '@type': 'ListItem', position: 3, name: page.hero.eyebrow, item: absolute(getRoute(locale, 'affectedPeople')) }
    ]
  }
];
---

<BaseLayout
  locale={locale}
  title={page.meta.title}
  description={page.meta.description}
  canonicalPath={getRoute(locale, 'affectedPeople')}
  alternatePath={getRoute(otherLocale, 'affectedPeople')}
  plPath={getRoute('pl', 'affectedPeople')}
  enPath={getRoute('en', 'affectedPeople')}
  xDefaultPath={getRoute('pl', 'affectedPeople')}
  currentPage="services"
  structuredData={schema}
>
  <main id="main-content" class="commercial-page capability-page affected-people-page">
    <PageIntro
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      lead={page.hero.lead}
      action={{ label: page.hero.cta, href: getContactPathWithTopic(locale, 'affected-people') }}
    />

    <section class="capability-situations" aria-labelledby="people-situations-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow">{page.situations.eyebrow}</p>
          <h2 id="people-situations-title">{page.situations.title}</h2>
          <p>{page.situations.intro}</p>
        </div>
        <ol class="capability-situation-list" data-reveal>
          {page.situations.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="capability-people-flow" aria-labelledby="people-flow-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow">{page.supportFlow.eyebrow}</p>
          <h2 id="people-flow-title">{page.supportFlow.title}</h2>
        </div>
        <ol class="people-support-flow" data-reveal>
          {page.supportFlow.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="responsibility-network" aria-labelledby="responsibility-network-title">
      <div class="wrap capability-editorial-grid">
        <div data-reveal>
          <p class="eyebrow">{page.responsibilities.eyebrow}</p>
          <h2 id="responsibility-network-title">{page.responsibilities.title}</h2>
        </div>
        <ul class="responsibility-network-list" data-reveal>
          {page.responsibilities.items.map((item) => {
            const href = responsibilityHref(item.id);
            return (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                {href && (
                  <a class="text-link" href={href}>
                    {responsibilityLink(item.id)} <span aria-hidden="true">→</span>
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="capability-routes" aria-labelledby="people-routes-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow eyebrow--light">{page.routes.eyebrow}</p>
          <h2 id="people-routes-title">{page.routes.title}</h2>
        </div>
        <ol class="capability-route-list capability-route-list--two" data-reveal>
          {page.routes.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a class="text-link text-link--light" href={routeHref(item.id)}>
                {item.link} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="capability-outcomes" aria-labelledby="people-outcomes-title">
      <div class="wrap capability-editorial-grid">
        <div data-reveal>
          <p class="eyebrow">{page.outcomes.eyebrow}</p>
          <h2 id="people-outcomes-title">{page.outcomes.title}</h2>
        </div>
        <ul class="capability-outcome-list" data-reveal>
          {page.outcomes.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    {insights.length > 0 && (
      <CommercialInsights
        locale={locale}
        entries={insights}
        eyebrow={page.insights.eyebrow}
        title={page.insights.title}
        copy={page.insights.copy}
      />
    )}
    <ContactBand locale={locale} content={page.contact} topic="affected-people" />
  </main>
</BaseLayout>
