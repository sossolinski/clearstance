---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import { getCommercialContent } from '../../content/commercial';
import { getContactPathWithTopic } from '../../lib/contact-topics';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getInsightsByTranslationKeys } from '../../lib/insights';
import CommercialInsights from '../insights/CommercialInsights.astro';
import ContactBand from '../sections/ContactBand.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const page = getCommercialContent(locale).crisisManagement;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const insights = await getInsightsByTranslationKeys(locale, [
  'crisis-situational-awareness',
  'continuity-at-interfaces'
]);
const absolute = (path: string) => new URL(path, Astro.site).toString();
const interfaceHref = (id: typeof page.interfaces.items[number]['id']) => {
  if (id === 'communication') {
    return `${getRoute(locale, 'services')}#${locale === 'pl' ? 'komunikacja-kryzysowa' : 'crisis-communication'}`;
  }

  if (id === 'affected-people') {
    return `${getRoute(locale, 'services')}#${locale === 'pl' ? 'wsparcie-osob-i-rodzin' : 'affected-people'}`;
  }

  return undefined;
};
const routeHref = (id: typeof page.routes.items[number]['id']) => {
  if (id === 'readiness-review') {
    return `${getRoute(locale, 'services')}#${locale === 'pl' ? 'przeglad-gotowosci' : 'readiness-review'}`;
  }

  if (id === 'cmt-model') {
    return `${getRoute(locale, 'services')}#${locale === 'pl' ? 'model-dzialania-cmt' : 'cmt-operating-model'}`;
  }

  return getRoute(locale, 'executiveTabletop');
};
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: page.hero.eyebrow,
    description: page.meta.description,
    serviceType: locale === 'pl' ? 'Doradztwo w zarządzaniu kryzysowym' : 'Crisis management advisory',
    provider: { '@type': 'Organization', name: 'ClearStance' },
    url: absolute(getRoute(locale, 'crisisManagement')),
    areaServed: { '@type': 'Country', name: 'Poland' }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: locale === 'pl' ? 'Strona główna' : 'Home', item: absolute(getRoute(locale, 'home')) },
      { '@type': 'ListItem', position: 2, name: locale === 'pl' ? 'Doradztwo' : 'Advisory', item: absolute(getRoute(locale, 'services')) },
      { '@type': 'ListItem', position: 3, name: page.hero.eyebrow, item: absolute(getRoute(locale, 'crisisManagement')) }
    ]
  }
];
---

<BaseLayout
  locale={locale}
  title={page.meta.title}
  description={page.meta.description}
  canonicalPath={getRoute(locale, 'crisisManagement')}
  alternatePath={getRoute(otherLocale, 'crisisManagement')}
  plPath={getRoute('pl', 'crisisManagement')}
  enPath={getRoute('en', 'crisisManagement')}
  xDefaultPath={getRoute('pl', 'crisisManagement')}
  currentPage="services"
  structuredData={schema}
>
  <main id="main-content" class="commercial-page capability-page crisis-management-page">
    <PageIntro
      eyebrow={page.hero.eyebrow}
      title={page.hero.title}
      lead={page.hero.lead}
      action={{
        label: page.hero.cta,
        href: getContactPathWithTopic(locale, 'crisis-management')
      }}
    />

    <section class="capability-situations" aria-labelledby="capability-situations-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow">{page.situations.eyebrow}</p>
          <h2 id="capability-situations-title">{page.situations.title}</h2>
          <p>{page.situations.intro}</p>
        </div>
        <ol class="capability-situation-list" data-reveal>
          {page.situations.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="capability-model" aria-labelledby="capability-model-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow">{page.model.eyebrow}</p>
          <h2 id="capability-model-title">{page.model.title}</h2>
          <p>{page.model.intro}</p>
        </div>
        <ol class="capability-model-list" data-reveal>
          {page.model.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="capability-interfaces" aria-labelledby="capability-interfaces-title">
      <div class="wrap capability-editorial-grid">
        <div data-reveal>
          <p class="eyebrow">{page.interfaces.eyebrow}</p>
          <h2 id="capability-interfaces-title">{page.interfaces.title}</h2>
          <p class="section-lead">{page.interfaces.intro}</p>
        </div>
        <ul class="capability-interface-list" data-reveal>
          {page.interfaces.items.map((item) => {
            const href = interfaceHref(item.id);
            return (
              <li>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                {href && (
                  <a class="text-link" href={href}>
                    {page.interfaces.link} <span aria-hidden="true">→</span>
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>

    <section class="capability-routes" aria-labelledby="capability-routes-title">
      <div class="wrap">
        <div class="commercial-section-heading" data-reveal>
          <p class="eyebrow eyebrow--light">{page.routes.eyebrow}</p>
          <h2 id="capability-routes-title">{page.routes.title}</h2>
        </div>
        <ol class="capability-route-list" data-reveal>
          {page.routes.items.map((item, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <a class="text-link text-link--light" href={routeHref(item.id)}>
                {item.link} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="capability-outcomes" aria-labelledby="capability-outcomes-title">
      <div class="wrap capability-editorial-grid">
        <div data-reveal>
          <p class="eyebrow">{page.outcomes.eyebrow}</p>
          <h2 id="capability-outcomes-title">{page.outcomes.title}</h2>
          <p class="section-lead">{page.outcomes.intro}</p>
        </div>
        <ul class="capability-outcome-list" data-reveal>
          {page.outcomes.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    {insights.length > 0 && (
      <CommercialInsights
        locale={locale}
        entries={insights}
        eyebrow={page.insights.eyebrow}
        title={page.insights.title}
        copy={page.insights.copy}
      />
    )}
    <ContactBand locale={locale} content={page.contact} topic="crisis-management" />
  </main>
</BaseLayout>
