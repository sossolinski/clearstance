---
import { getCollection } from 'astro:content';
import type { Locale } from '../../i18n/routes';
import { formatDate, getArticlePath, getRoute } from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const content = t.insightsPage;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const entries = (await getCollection('insights', ({ data }) => data.locale === locale))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout
  locale={locale}
  title={content.metaTitle}
  description={content.metaDescription}
  canonicalPath={getRoute(locale, 'insights')}
  alternatePath={getRoute(otherLocale, 'insights')}
  plPath={getRoute('pl', 'insights')}
  enPath={getRoute('en', 'insights')}
  xDefaultPath={getRoute('pl', 'insights')}
  currentPage="insights"
>
  <main id="main-content">
    <PageIntro
      eyebrow={content.eyebrow}
      title={content.title}
      lead={content.lead}
    />

    <section class="insights-index" aria-labelledby="insights-list-title">
      <div class="wrap">
        <h2 id="insights-list-title" class="sr-only">
          {locale === 'pl' ? 'Lista materiałów' : 'Insight materials'}
        </h2>
        {
          entries.length > 0 ? (
            <>
              {entries.some((entry) => entry.data.draft) && (
                <p class="demo-notice" data-reveal>
                  <span>{content.demoLabel}</span>
                  {content.draftNotice}
                </p>
              )}
              <ol class="insights-list">
                {entries.map((entry, index) => (
                  <li data-reveal>
                    <article>
                      <div class="insight-meta">
                        <span>{String(index + 1).padStart(2, '0')}</span>
                        <span>{entry.data.category}</span>
                        <time datetime={entry.data.publishedAt.toISOString()}>
                          {formatDate(entry.data.publishedAt, locale)}
                        </time>
                      </div>
                      {entry.data.draft && <span class="demo-label">{content.demoLabel}</span>}
                      <h3>
                        <a href={getArticlePath(locale, entry.data.slug)}>
                          {entry.data.title}
                        </a>
                      </h3>
                      <p>{entry.data.description}</p>
                      <a class="text-link" href={getArticlePath(locale, entry.data.slug)}>
                        {content.read}
                        <span aria-hidden="true">↗</span>
                      </a>
                    </article>
                  </li>
                ))}
              </ol>
            </>
          ) : (
            <p class="insights-empty">{content.empty}</p>
          )
        }
      </div>
    </section>
  </main>
</BaseLayout>
