---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import {
  getTranslations,
  getVisibleTranslations
} from '../../i18n/translations';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../sections/PageIntro.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const content = getVisibleTranslations(locale).contactPage;
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const turnstileSiteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY?.trim() ||
  (import.meta.env.DEV ? '1x00000000000000000000AA' : '');
const formAvailable = Boolean(turnstileSiteKey);
---

<BaseLayout
  locale={locale}
  title={t.contactPage.metaTitle}
  description={t.contactPage.metaDescription}
  canonicalPath={getRoute(locale, 'contact')}
  alternatePath={getRoute(otherLocale, 'contact')}
  plPath={getRoute('pl', 'contact')}
  enPath={getRoute('en', 'contact')}
  xDefaultPath={getRoute('pl', 'contact')}
  currentPage="contact"
>
  <main id="main-content">
    <PageIntro
      eyebrow={content.eyebrow}
      title={content.title}
      lead={content.lead}
    />

    <section class="contact-page" aria-labelledby="contact-form-title">
      <div class="wrap contact-page-layout" data-reveal>
        <div class="contact-details">
          <p class="eyebrow">{content.form.eyebrow}</p>
          <h2 id="contact-form-title">{content.form.title}</h2>
          <p class="contact-intro">{content.note}</p>

          <div class="contact-detail">
            <span>{content.emailLabel}</span>
            <a href={`mailto:${t.site.email}`}>{content.cta}</a>
          </div>
          <div class="contact-detail">
            <span>{content.locationLabel}</span>
            <strong>{t.site.location}</strong>
          </div>
        </div>

        <form
          class="contact-form"
          id="contact-form"
          method="post"
          action="/api/contact"
          aria-labelledby="contact-form-title"
          aria-describedby="contact-form-status"
          data-success-message={content.form.success}
          data-timeout-message={content.form.timeout}
          data-failure-message={content.form.failure}
          data-verification-message={content.form.verification}
          data-sending-label={content.form.sending}
          data-submit-label={content.form.submit}
        >
          <input type="hidden" name="locale" value={locale} />
          <input type="hidden" name="source" value={getRoute(locale, 'contact')} data-contact-source />

          <div class="contact-form-trap" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input
              id="contact-website"
              name="website"
              type="text"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="contact-form-row">
            <div class="contact-field">
              <label for="contact-name">{content.form.name}</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                maxlength="120"
                required
              />
            </div>

            <div class="contact-field">
              <label for="contact-email">{content.form.email}</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                inputmode="email"
                autocomplete="email"
                maxlength="254"
                required
              />
            </div>
          </div>

          <div class="contact-field">
            <label for="contact-organisation">{content.form.organisation}</label>
            <input
              id="contact-organisation"
              name="organisation"
              type="text"
              autocomplete="organization"
              maxlength="160"
            />
          </div>

          <div class="contact-field">
            <label for="contact-message">{content.form.message}</label>
            <textarea
              id="contact-message"
              name="message"
              rows="6"
              minlength="10"
              maxlength="5000"
              required
            ></textarea>
          </div>

          {
            turnstileSiteKey && (
              <div class="contact-turnstile">
                <div
                  class="cf-turnstile"
                  data-sitekey={turnstileSiteKey}
                  data-action="contact"
                  data-appearance="interaction-only"
                  data-size="flexible"
                  data-theme="light"
                  data-language={locale}
                  data-callback="clearstanceTurnstileSuccess"
                  data-error-callback="clearstanceTurnstileIssue"
                  data-expired-callback="clearstanceTurnstileIssue"
                  data-timeout-callback="clearstanceTurnstileIssue"
                />
              </div>
            )
          }

          <div class="contact-form-footer">
            <button
              class="button button--dark"
              type="submit"
              disabled={!formAvailable}
              aria-disabled={formAvailable ? undefined : 'true'}
            >
              <span data-contact-submit-label>{content.form.submit}</span>
              <span aria-hidden="true">↗</span>
            </button>
            <p
              id="contact-form-status"
              class="contact-form-status"
              role="status"
              aria-live="polite"
              tabindex="-1"
            >
              {!formAvailable ? content.form.unavailable : ''}
            </p>
          </div>
        </form>
      </div>
    </section>

    <section class="contact-page-statement" aria-label="ClearStance">
      <picture>
        <source
          srcset="
            /images/brand-statement-640.webp 640w,
            /images/brand-statement-960.webp 960w,
            /images/brand-statement-1440.webp 1440w,
            /images/brand-statement.webp 1920w
          "
          sizes="100vw"
          type="image/webp"
        />
        <img
          src="/images/brand-statement.jpg"
          width="1920"
          height="1080"
          alt=""
          loading="lazy"
        />
      </picture>
      <div class="contact-page-overlay" aria-hidden="true"></div>
      <div class="wrap">
        <p>ClearStance</p>
        <strong>Clarity when it matters most.</strong>
      </div>
    </section>
  </main>

  {
    turnstileSiteKey && (
      <script is:inline>
        const updateContactVerificationStatus = (hasIssue) => {
          const form = document.querySelector('#contact-form');
          const status = form?.querySelector('#contact-form-status');

          if (!(form instanceof HTMLFormElement) || !(status instanceof HTMLElement)) {
            return;
          }

          if (!hasIssue) {
            if (status.dataset.turnstileIssue === 'true') {
              status.textContent = '';
              status.dataset.state = '';
              delete status.dataset.turnstileIssue;
            }

            return;
          }

          status.textContent = form.dataset.verificationMessage || '';
          status.dataset.state = 'error';
          status.dataset.turnstileIssue = 'true';
        };

        window.clearstanceTurnstileSuccess = () => {
          updateContactVerificationStatus(false);
        };
        window.clearstanceTurnstileIssue = () => {
          updateContactVerificationStatus(true);
          return true;
        };
      </script>
    )
  }

  {
    turnstileSiteKey && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
      />
    )
  }

  <script>
    import { initialiseContactForm } from '../../scripts/contact-form';

    initialiseContactForm();
  </script>
</BaseLayout>
