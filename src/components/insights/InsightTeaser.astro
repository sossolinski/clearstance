---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/routes';
import { formatDate, getArticlePath } from '../../i18n/routes';
import { formatVisibleText } from '../../i18n/typography.js';
import { calculateReadingTime } from '../../lib/insights';

interface Props {
  entry: CollectionEntry<'insights'>;
  index: number;
  locale: Locale;
  readLabel: string;
  readingTimeUnit: string;
}

const {
  entry,
  index,
  locale,
  readLabel,
  readingTimeUnit
} = Astro.props;
const readingMinutes = calculateReadingTime(entry.body ?? '');
---

<li data-reveal>
  <article
    class:list={{
      'insight-item': true,
      'insight-item--with-image': Boolean(entry.data.headerImage)
    }}
  >
    <div class="insight-item-copy">
      <div class="insight-meta">
        <span>{String(index + 1).padStart(2, '0')}</span>
        <span>{formatVisibleText(entry.data.category, locale)}</span>
        <time datetime={entry.data.publishedAt.toISOString()}>
          {formatDate(entry.data.publishedAt, locale)}
        </time>
        <span>{readingMinutes} {readingTimeUnit}</span>
      </div>
      <h3>
        <a href={getArticlePath(locale, entry.data.slug)}>
          {formatVisibleText(entry.data.title, locale)}
        </a>
      </h3>
      <p>{formatVisibleText(entry.data.description, locale)}</p>
      <span class="text-link insight-read" aria-hidden="true">
        {readLabel}
        <span>↗</span>
      </span>
    </div>
    {
      entry.data.headerImage && (
        <div class="insight-thumbnail" aria-hidden="true">
          <img
            src={entry.data.headerImage}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
  </article>
</li>
