---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n/routes';
import { formatDate, getArticlePath } from '../../i18n/routes';
import { formatVisibleText } from '../../i18n/typography.js';
import { resolveInsightEntryVisual } from '../../lib/insight-visual-theme';
import { calculateReadingTime } from '../../lib/insights';
import InsightVisual from './InsightVisual.astro';

interface Props {
  entry: CollectionEntry<'insights'>;
  locale: Locale;
  readLabel: string;
  readingTimeUnit: string;
}

const {
  entry,
  locale,
  readLabel,
  readingTimeUnit
} = Astro.props;
const readingMinutes = calculateReadingTime(entry.body ?? '');
const visual = resolveInsightEntryVisual({
  headerImage: entry.data.headerImage,
  visualTheme: entry.data.visualTheme,
  category: entry.data.category
});
---

<li data-reveal>
  <article
    class:list={{
      'insight-item': true,
      'insight-item--with-visual': visual.kind !== 'typographic'
    }}
  >
    <div class="insight-item-copy">
      <div class="insight-meta">
        <span>{formatVisibleText(entry.data.category, locale)}</span>
        <time datetime={entry.data.publishedAt.toISOString()}>
          {formatDate(entry.data.publishedAt, locale)}
        </time>
        <span>{readingMinutes} {readingTimeUnit}</span>
      </div>
      <h3>
        <a href={getArticlePath(locale, entry.data.slug)}>
          {formatVisibleText(entry.data.title, locale)}
        </a>
      </h3>
      <p>{formatVisibleText(entry.data.description, locale)}</p>
      <span class="text-link insight-read" aria-hidden="true">
        {readLabel}
        <span>↗</span>
      </span>
    </div>
    {
      visual.kind === 'image' && (
        <div class="insight-thumbnail insight-thumbnail--image" aria-hidden="true">
          <img
            src={visual.src}
            alt=""
            loading="lazy"
            decoding="async"
          />
        </div>
      )
    }
    {
      visual.kind === 'micro-illustration' && (
        <div
          class="insight-thumbnail insight-thumbnail--illustration"
          aria-hidden="true"
        >
          <InsightVisual variant={visual.theme} />
        </div>
      )
    }
  </article>
</li>
