---
import type { Locale } from '../../i18n/routes';
import { getArticlePath, getRoute } from '../../i18n/routes';
import { getTranslations } from '../../i18n/translations';
import { formatVisibleText } from '../../i18n/typography.js';
import { getCommercialContent } from '../../content/commercial';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getHomepageInsights } from '../../lib/insights';
import CommercialInsights from '../insights/CommercialInsights.astro';
import ContactBand from './ContactBand.astro';
import Icon from '../ui/Icon.astro';
import ExperienceMedia from '../ui/ExperienceMedia.astro';

interface Props { locale: Locale; }

const { locale } = Astro.props;
const t = getTranslations(locale);
const commercial = getCommercialContent(locale);
const content = commercial.home;
const { featured: featuredInsight, entries: homepageInsights } = await getHomepageInsights(locale);
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const ids = locale === 'pl'
  ? { capabilities: 'kompetencje', ways: 'wspolpraca', engagements: 'zakresy', readiness: 'gotowosc', experience: 'doswiadczenie' }
  : { capabilities: 'capabilities', ways: 'ways-of-working', engagements: 'engagements', readiness: 'readiness', experience: 'experience' };
const capabilityIcons = ['network', 'message-text', 'community'] as const;
const professionalServiceSchema = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'ClearStance',
  url: new URL(getRoute(locale, 'home'), Astro.site).toString(), email: t.site.email,
  areaServed: { '@type': 'Country', name: locale === 'pl' ? 'Polska' : 'Poland' },
  knowsAbout: commercial.capabilities.map(({ title }) => title)
};
---

<BaseLayout locale={locale} title={content.meta.title} description={content.meta.description}
  canonicalPath={getRoute(locale, 'home')} alternatePath={getRoute(otherLocale, 'home')}
  plPath={getRoute('pl', 'home')} enPath={getRoute('en', 'home')} xDefaultPath={getRoute('pl', 'home')}
  onHomepage structuredData={professionalServiceSchema}>
  <main id="main-content" class="commercial-page">
    <section class="hero" aria-labelledby="hero-title">
      <picture class="hero-media">
        <source media="(max-width: 760px)" srcset="/images/hero-lighthouse-horizon-mobile-640.avif 640w, /images/hero-lighthouse-horizon-mobile-900.avif 900w" sizes="100vw" width="1024" height="1536" type="image/avif" />
        <source media="(min-width: 761px)" srcset="/images/hero-lighthouse-horizon-desktop-640.avif 640w, /images/hero-lighthouse-horizon-desktop-960.avif 960w, /images/hero-lighthouse-horizon-desktop-1440.avif 1440w, /images/hero-lighthouse-horizon-desktop-1920.avif 1920w" sizes="100vw" width="1671" height="941" type="image/avif" />
        <source media="(max-width: 760px)" srcset="/images/hero-lighthouse-horizon-mobile-640.webp 640w, /images/hero-lighthouse-horizon-mobile-900.webp 900w" sizes="100vw" width="1024" height="1536" type="image/webp" />
        <source media="(min-width: 761px)" srcset="/images/hero-lighthouse-horizon-desktop-640.webp 640w, /images/hero-lighthouse-horizon-desktop-960.webp 960w, /images/hero-lighthouse-horizon-desktop-1440.webp 1440w, /images/hero-lighthouse-horizon-desktop-1920.webp 1920w" sizes="100vw" width="1671" height="941" type="image/webp" />
        <img src="/images/hero-lighthouse-horizon-desktop-master.png" width="1671" height="941" alt={t.home.hero.imageAlt} fetchpriority="high" />
      </picture>
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="wrap hero-content"><div class="hero-primary">
        <p class="eyebrow eyebrow--light">{content.hero.eyebrow}</p>
        <h1 id="hero-title">{content.hero.title} <span>{content.hero.titleAccent}</span></h1>
        <p class="hero-copy">{content.hero.copy}</p>
        <div class="hero-actions">
          <a class="button button--ghost" href={`#${ids.capabilities}`}><span>{content.hero.primaryCta}</span><span aria-hidden="true">↓</span></a>
          <a class="hero-secondary-link" href={getRoute(locale, 'exercises')}>{content.hero.secondaryCta} <span aria-hidden="true">→</span></a>
        </div>
      </div></div>
      {featuredInsight && <aside class="hero-featured" aria-labelledby="hero-featured-title">
        <a class="hero-featured-link" href={getArticlePath(locale, featuredInsight.data.slug)}><div class="wrap hero-featured-inner">
          <p class="hero-featured-signature">ClearStance Insights</p><span class="hero-featured-divider" aria-hidden="true"></span>
          <h2 id="hero-featured-title" class="hero-featured-title">{formatVisibleText(featuredInsight.data.title, locale)}</h2><span class="hero-featured-arrow" aria-hidden="true">→</span>
        </div></a>
      </aside>}
    </section>

    <section class="services-section commercial-capabilities" id={ids.capabilities} aria-labelledby="capabilities-title"><div class="wrap">
      <div class="services-heading" data-reveal><div><p class="eyebrow">{content.capabilities.eyebrow}</p><h2 id="capabilities-title">{content.capabilities.title}</h2></div><p>{content.capabilities.intro}</p></div>
      <ul class="service-list" data-reveal>{commercial.capabilities.map((capability, index) => <li>
        <Icon class="service-icon" name={capabilityIcons[index]} size={36} decorative />
        <h3>{capability.title}</h3><div class="capability-row-copy"><p>{capability.text}</p><a class="text-link" href={`${getRoute(locale, 'services')}#${capability.anchor}`}>{locale === 'pl' ? 'Poznaj zakres' : 'Explore the scope'} <span aria-hidden="true">→</span></a></div>
      </li>)}</ul>
    </div></section>

    <section class="ways-section" id={ids.ways} aria-labelledby="ways-title"><div class="wrap" data-reveal>
      <div class="commercial-section-heading"><p class="eyebrow">{content.ways.eyebrow}</p><h2 id="ways-title">{content.ways.title}</h2><p>{content.ways.intro}</p></div>
      <ol class="ways-list">{[
        { ...content.ways.advisory, href: getRoute(locale, 'services') },
        { ...content.ways.exercises, href: getRoute(locale, 'exercises') }
      ].map((item, index) => <li><span class="ways-marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{item.title}</h3><p>{item.text}</p><a class="text-link" href={item.href}>{item.link} <span aria-hidden="true">→</span></a></li>)}</ol>
    </div></section>

    <section class="engagements-section" id={ids.engagements} aria-labelledby="engagements-title"><div class="wrap" data-reveal>
      <div class="commercial-section-heading"><p class="eyebrow eyebrow--light">{content.engagements.eyebrow}</p><h2 id="engagements-title">{content.engagements.title}</h2><p>{content.engagements.intro}</p></div>
      <div class="engagement-grid">{[
        { ...content.engagements.review, href: `${getRoute(locale, 'services')}#${locale === 'pl' ? 'przeglad-gotowosci' : 'readiness-review'}` },
        { ...content.engagements.tabletop, href: getRoute(locale, 'executiveTabletop') }
      ].map((item) => <article class="engagement-card"><p class="engagement-type">{item.type}</p><h3>{item.title}</h3><p>{item.text}</p><a class="text-link text-link--light" href={item.href}>{item.link} <span aria-hidden="true">→</span></a></article>)}</div>
    </div></section>

    <section class="readiness-approach-section" id={ids.readiness} aria-labelledby="readiness-title"><div class="wrap">
      <div class="readiness-approach-heading" data-reveal><div><p class="eyebrow eyebrow--light">{content.readiness.eyebrow}</p><h2 id="readiness-title">{content.readiness.title}</h2></div><blockquote>{content.readiness.quote.map((line) => <span>{line}</span>)}</blockquote></div>
      <ol class="readiness-stage-list" data-reveal>{content.readiness.stages.map((stage, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><h3>{stage.title}</h3><p>{stage.text}</p></li>)}</ol>
      <div class="approach-panel" data-reveal><div><h3>{content.readiness.approachTitle}</h3><p>{content.readiness.approachLead}</p></div><ul>{content.readiness.principles.map((item) => <li><h4>{item.title}</h4><p>{item.text}</p></li>)}</ul></div>
    </div></section>

    <section class="experience-section" id={ids.experience} aria-labelledby="experience-title"><div class="wrap experience-grid" data-reveal>
      <div><p class="eyebrow">{content.experience.eyebrow}</p><h2 id="experience-title">{content.experience.title}</h2></div>
      <ExperienceMedia surface="home" maritimeAlt={t.home.experience.mediaAlt.maritime} aviationAlt={t.home.experience.mediaAlt.aviation} />
      <div class="experience-copy">{content.experience.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<ul class="experience-tracks">{content.experience.tracks.map((track) => <li><strong>{track.title}</strong><span>{track.text}</span></li>)}</ul><p>{content.experience.closing}</p><a class="text-link" href={getRoute(locale, 'about')}>{content.experience.link} <span aria-hidden="true">↗</span></a></div>
    </div></section>

    {homepageInsights.length > 0 && <CommercialInsights locale={locale} entries={homepageInsights} eyebrow={content.insights.eyebrow} title={content.insights.title} copy={content.insights.copy} showAll />}
    <ContactBand locale={locale} content={content.contact} />
  </main>
</BaseLayout>
