---
import type { Locale } from '../../i18n/routes';
import { getRoute } from '../../i18n/routes';
import {
  getTranslations,
  getVisibleTranslations
} from '../../i18n/translations';

interface Props {
  locale: Locale;
  showMeta?: boolean;
}

const { locale, showMeta = true } = Astro.props;
const t = getTranslations(locale);
const content = getVisibleTranslations(locale).home.contact;
---

<section
  class="contact-band"
  id={locale === 'pl' ? 'kontakt' : 'contact'}
  aria-labelledby="contact-band-title"
>
  <div class="wrap contact-band-grid" data-reveal>
    <div>
      <p class="eyebrow">{content.eyebrow}</p>
      <h2 id="contact-band-title">{content.title}</h2>
    </div>
    <div class="contact-band-action">
      <p>{content.text}</p>
      <a class="button button--dark" href={getRoute(locale, 'contact')}>
        <span>{content.cta}</span>
        <span aria-hidden="true">↗</span>
      </a>
      {
        showMeta && (
          <span class="contact-band-meta">
            <a href={`mailto:${t.site.email}`}>{t.site.email}</a>
            {' · '}
            {t.site.location}
          </span>
        )
      }
    </div>
  </div>
</section>
