---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  titleId?: string;
  variant?: 'default' | 'about';
  desktopTitleLines?: readonly string[];
  action?: { label: string; href: string };
}

const {
  eyebrow,
  title,
  lead,
  titleId = 'page-title',
  variant = 'default',
  desktopTitleLines,
  action
} = Astro.props;
---

<section class:list={['page-intro', { 'page-intro--about': variant === 'about' }]} aria-labelledby={titleId}>
  <div class="wrap page-intro-grid">
    <div>
      <p class="eyebrow eyebrow--light">{eyebrow}</p>
      {
        desktopTitleLines ? (
          <h1
            id={titleId}
            class="page-intro-composed-title"
            aria-label={title}
          >
            {desktopTitleLines.map((line) => (
              <span class="page-intro-title-line" aria-hidden="true">{line}</span>
            ))}
          </h1>
        ) : (
          <h1 id={titleId}>{title}</h1>
        )
      }
    </div>
    {
      action ? (
        <div class="page-intro-action">
          <p class="page-intro-lead">{lead}</p>
          <a class="button button--ghost" href={action.href}>
            <span>{action.label}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      ) : (
        <p class="page-intro-lead">{lead}</p>
      )
    }
  </div>
  <div class="page-intro-line" aria-hidden="true"></div>
</section>
