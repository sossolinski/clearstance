---
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import {
  getAlternateInsight,
  getPublishedInsights,
  getRelatedInsights
} from '../../lib/insights';

export async function getStaticPaths() {
  const entries = await getPublishedInsights('pl');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const publishedEntries = await getPublishedInsights();
const alternateEntry = getAlternateInsight(entry, publishedEntries);
const relatedEntries = getRelatedInsights(entry, publishedEntries);
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);
---

<ArticleLayout
  entry={entry}
  alternateEntry={alternateEntry}
  headings={tocHeadings}
  relatedEntries={relatedEntries}
>
  <Content />
</ArticleLayout>
