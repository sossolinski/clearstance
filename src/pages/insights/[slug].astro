---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection(
    'insights',
    ({ data }) => data.locale === 'pl' && !data.draft
  );
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry }
  }));
}

interface Props {
  entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const allEntries = await getCollection('insights', ({ data }) => !data.draft);
const alternateEntry = allEntries.find(
  (candidate) =>
    candidate.data.locale === 'en' &&
    candidate.data.translationKey === entry.data.translationKey
);
const { Content, headings } = await render(entry);
const tocHeadings = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3
);
---

<ArticleLayout
  entry={entry}
  alternateEntry={alternateEntry}
  headings={tocHeadings}
>
  <Content />
</ArticleLayout>
