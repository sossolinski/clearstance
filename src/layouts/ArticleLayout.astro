---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/routes';
import { formatDate, getArticlePath, getRoute } from '../i18n/routes';
import { getVisibleTranslations } from '../i18n/translations';
import { formatVisibleText } from '../i18n/typography.js';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'insights'>;
  alternateEntry?: CollectionEntry<'insights'>;
}

const { entry, alternateEntry } = Astro.props;
const locale = entry.data.locale as Locale;
const visible = getVisibleTranslations(locale);
const path = getArticlePath(locale, entry.data.slug);
const alternatePath = alternateEntry
  ? getArticlePath(alternateEntry.data.locale as Locale, alternateEntry.data.slug)
  : getRoute(locale === 'pl' ? 'en' : 'pl', 'insights');
const plPath = locale === 'pl'
  ? path
  : alternateEntry?.data.locale === 'pl'
    ? getArticlePath('pl', alternateEntry.data.slug)
    : undefined;
const enPath = locale === 'en'
  ? path
  : alternateEntry?.data.locale === 'en'
    ? getArticlePath('en', alternateEntry.data.slug)
    : undefined;
const xDefaultPath = plPath ?? getRoute('pl', 'insights');
const headerImageAlt = entry.data.headerImage
  ? entry.data.headerImageAlt ?? ''
  : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt.toISOString(),
  ...(entry.data.updatedAt ? { dateModified: entry.data.updatedAt.toISOString() } : {}),
  author: {
    '@type': 'Organization',
    name: entry.data.author
  },
  publisher: {
    '@type': 'Organization',
    name: 'ClearStance'
  },
  ...(entry.data.headerImage
    ? { image: new URL(entry.data.headerImage, Astro.site).toString() }
    : {}),
  inLanguage: locale,
  mainEntityOfPage: new URL(path, Astro.site).toString()
};
---

<BaseLayout
  locale={locale}
  title={entry.data.seoTitle}
  description={entry.data.seoDescription}
  canonicalPath={path}
  alternatePath={alternatePath}
  plPath={plPath}
  enPath={enPath}
  xDefaultPath={xDefaultPath}
  currentPage="insights"
  ogImage={entry.data.headerImage}
  structuredData={articleSchema}
  article
>
  <main id="main-content">
    <article
      class:list={{
        article: true,
        'article--with-image': Boolean(entry.data.headerImage)
      }}
    >
      <header class="article-header">
        <div class="wrap article-header-inner">
          <a class="back-link" href={getRoute(locale, 'insights')}>
            <span aria-hidden="true">←</span>
            {visible.insightsPage.back}
          </a>
          <p class="eyebrow eyebrow--light">{formatVisibleText(entry.data.category, locale)}</p>
          <h1>{formatVisibleText(entry.data.title, locale)}</h1>
          <p class="article-deck">{formatVisibleText(entry.data.description, locale)}</p>
          <dl class="article-meta">
            <div>
              <dt>{visible.insightsPage.published}</dt>
              <dd><time datetime={entry.data.publishedAt.toISOString()}>{formatDate(entry.data.publishedAt, locale)}</time></dd>
            </div>
            {
              entry.data.updatedAt && (
                <div>
                  <dt>{visible.insightsPage.updated}</dt>
                  <dd><time datetime={entry.data.updatedAt.toISOString()}>{formatDate(entry.data.updatedAt, locale)}</time></dd>
                </div>
              )
            }
            <div>
              <dt>{visible.insightsPage.author}</dt>
              <dd>{formatVisibleText(entry.data.author, locale)}</dd>
            </div>
          </dl>
        </div>
      </header>
      {
        entry.data.headerImage && (
          <div class="wrap article-header-image">
            <img
              src={entry.data.headerImage}
              alt={headerImageAlt}
              decoding="async"
              fetchpriority="high"
            />
          </div>
        )
      }
      <div class="wrap article-grid">
        <aside class="article-aside">
          <span>{visible.insightsPage.category}</span>
          <strong>{formatVisibleText(entry.data.category, locale)}</strong>
          <ul aria-label={locale === 'pl' ? 'Tagi artykułu' : 'Article tags'}>
            {entry.data.tags.map((tag) => <li>{formatVisibleText(tag, locale)}</li>)}
          </ul>
        </aside>
        <div class="article-prose">
          <slot />
        </div>
      </div>
    </article>
  </main>
</BaseLayout>
