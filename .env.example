# Astro build-time configuration
# Cloudflare's documented Turnstile always-pass test site key.
# Use it only for local development. Production must use the site key for the
# Managed widget restricted to clearstance.pl, then rebuild the site.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sveltia CMS Authenticator Worker configuration.
# These values belong only in the isolated authenticator Worker.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_DOMAINS=clearstance.pl
