# Astro build-time configuration
# Cloudflare's documented Turnstile test site key; replace it in production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Sveltia CMS Authenticator Worker configuration.
# These values belong only in the isolated authenticator Worker.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ALLOWED_DOMAINS=clearstance.pl
